{
  "name": "coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/db/migrate.mjs && next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test scripts/*.test.mjs src/lib/*.test.mjs src/lib/plan/*.test.mjs src/lib/lift-dashboard/*.test.mjs src/lib/lift-sync/*.test.mjs src/lib/calendar-sync/*.test.mjs src/lib/strava-sync/*.test.mjs src/lib/performance/*.test.mjs src/lib/vitals/*.test.mjs src/lib/activity/*.test.mjs src/lib/goals/*.test.mjs src/lib/workouts/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "node scripts/db/migrate.mjs --yes",
    "typecheck": "tsc --noEmit -p .",
    "test:integration": "node --import tsx --test scripts/integration/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.8",
    "@neondatabase/serverless": "^1.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "googleapis": "^161.0.0",
    "lucide-react": "^0.544.0",
    "maplibre-gl": "6.11.2",
    "next": "15.5.28",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "sonner": "^2.0.7",
    "svix": "^1.76.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.31"
  },
  "resolutions": {
    "postcss": "^8.5.31"
  }
}
