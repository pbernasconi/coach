# Project values for scripts/ios-run.sh (RUNNING.md). Commit this file; it holds no secrets.
# Format: IOS_RUN_KEY=value, one per line. Paths are relative to this file. An environment variable with the
# same name wins over this file, and a flag wins over both.

IOS_RUN_SCHEME=App
IOS_RUN_PROJECT=App.xcodeproj
# IOS_RUN_WORKSPACE=App.xcworkspace
# IOS_RUN_SPEC=project.yml                 # default: project.yml next to this file
IOS_RUN_CONFIGURATION=Debug
# IOS_RUN_DEVICE_CONFIGURATION=Release     # default: IOS_RUN_CONFIGURATION
# IOS_RUN_PRODUCT=App                      # only when a build makes more than one .app
# IOS_RUN_BUNDLE_ID=com.example.app        # default: read from the built app
# IOS_RUN_TEAM_ID=ABCDE12345               # your Apple team id, for device builds

# A stable simulator: an exact name and OS. Each agent can set its own in the environment.
# IOS_RUN_SIM_NAME=iPhone 17
# IOS_RUN_SIM_OS=26.4

# IOS_RUN_DEVICE=My iPhone                 # default: the first available paired iPhone
# IOS_RUN_DERIVED_DATA=/tmp/dd-app         # default: one folder per checkout under $TMPDIR/ios-run
# IOS_RUN_JOBS=6                           # cap xcodebuild jobs when many builds share one Mac

# Launch arguments and environment for every launch (space-separated).
# IOS_RUN_LAUNCH_ARGS=-demo
# IOS_RUN_LAUNCH_ENV=API_BASE_URL=http://localhost:3000
